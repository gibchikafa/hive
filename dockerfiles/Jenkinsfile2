@Library("jenkins-library@main")

import com.logicalclocks.jenkins.k8s.ImageBuilder

properties([
    parameters([
        string(name: 'BRANCH_TO_BUILD', defaultValue: 'master', description: 'Hive branch to build')
    ])
])

node("local") {
    stage('Clone repository') {
        checkout([$class: 'GitSCM',
            branches: [[name: "${params.BRANCH_TO_BUILD}"]],
            userRemoteConfigs: [[
                url: 'git@github.com:gibchikafa/hive.git',
                credentialsId: 'id_rsa'
            ]],
            extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false]]
        ])
    }

    stage('Download Hive package') {
        sh "wget -q https://repo.hops.works/dev/gibson/hive-packaging-4.1.0-bin.tar.gz -O $WORKSPACE/dockerfiles/hive-packaging-4.1.0-bin.tar.gz"
    }

    stage('Build and push image(s)') {
      withCredentials([usernamePassword(credentialsId: 'a0770738-4ef3-4acc-a6ba-097ee6c85b44', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME')]) {
        withEnv(["HIVE_VERSION=4.1.0", "IMAGE_BUILD_VERSION=SNAPSHOT"]) {
          def builder = new ImageBuilder(this)

          sh "printf \"user=$USERNAME\npassword=$PASSWORD\" > $WORKSPACE/dockerfiles/wgetrc"
          sh "ls $WORKSPACE/dockerfiles"

          m = readFile "${env.WORKSPACE}/dockerfiles/build-manifest.json"
          builder.run(m)
        }
      }
    }
}
